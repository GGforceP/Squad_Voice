# Name or IP entered in Windows. Use a DNS record pointing directly at the host.
SQUADVOICE_HOST=voice.example.invalid
# Advertised by WebRTC, including behind 1:1 NAT or a home router.
SQUADVOICE_PUBLIC_IPV4=203.0.113.10
# Use shortlived for a public IP certificate. A DNS name can use tlsserver.
SQUADVOICE_ACME_PROFILE=tlsserver
# Stored image quota in MB.
cachesize=10240
# Account login name bound as owner when the container is created.
SQUADVOICE_OWNER=
# When enabled, include compose.updates.yaml and supply its installer directory.
ClientUdtCHK=false
# For registry images, replace the prefix with ghcr.io/<owner>/<repository>
# and the tag with the published version.
SQUADVOICE_IMAGE_PREFIX=squadvoice
SQUADVOICE_IMAGE_TAG=local
